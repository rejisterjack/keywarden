# Copy to .env and replace every value before storing a real credential.
# The defaults below are public and are only for the local fictional demo.

KEYWARDEN_DATABASE_URL=postgres://keywarden:keywarden@localhost:5432/keywarden?sslmode=disable
KEYWARDEN_ADMIN_TOKEN=local-dev-admin-token
# 32 bytes, base64. Generate a real key with: openssl rand -base64 32
KEYWARDEN_VAULT_KEY=QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=

KEYWARDEN_HTTP_ADDR=:8080
KEYWARDEN_DEMO=1
KEYWARDEN_SEED=1
KEYWARDEN_SINGLE_TENANT=1
KEYWARDEN_ORDERS_DSN=postgres://orders_owner:fake-orders-password@localhost:5432/orders?sslmode=disable

# Dashboard. The admin token stays on the server; the browser only gets a session cookie.
KEYWARDEN_API_URL=http://127.0.0.1:8080
KEYWARDEN_DASHBOARD_PASSWORD=local-demo-password
KEYWARDEN_SESSION_SECRET=local-demo-session-secret
